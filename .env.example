# Copy this file to ".env.local" for local work, and add the same names
# in Vercel under Project > Settings > Environment Variables.
# Never commit the real values.

# The public address of the site. Use the Vercel link now, your real domain later.
NEXT_PUBLIC_SITE_URL=https://nexvanta.vercel.app

# Google Apps Script contact integration.
# Keep the URL blank until the Apps Script Web App is deployed.
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_SECRET=
CONTACT_RECEIVER=nexvantadigitalsolutions@gmail.com
